# Скопируй этот файл в .env и заполни. Файл .env никому не показывай.

# ===== Обязательно =====

# Токен бота: напиши @BotFather → /newbot
BOT_TOKEN=

# Ключ Polza.ai: личный кабинет → API-ключи
POLZA_API_KEY=

# ===== Чтение Telegram-каналов =====
# my.telegram.org → API development tools (войди тем аккаунтом, который будет читать каналы).
# Если оставить пустым — бот будет читать только сайты.
TG_API_ID=
TG_API_HASH=

# ===== Необязательно =====

# Твой Telegram ID. Если пусто — владельцем станет первый, кто напишет боту /start
OWNER_ID=

# Модели. Каталог и цены: https://polza.ai/models
LLM_MODEL_FAST=openai/gpt-4.1-mini
LLM_MODEL_SMART=openai/gpt-5.4

# Подборки (время и количество можно менять прямо в боте: /time, /size, /threshold)
DIGEST_TIMES=10:00,19:00
TIMEZONE=Europe/Moscow
DIGEST_SIZE=7
MIN_SCORE=6
COLLECT_INTERVAL_MIN=30

# Прокси для Telegram, если он у тебя тормозит или не открывается:
# TG_PROXY=socks5://user:password@host:1080
TG_PROXY=
