# Скопируй этот файл в .env и заполни. Файл .env никому не показывай.

# ===== Обязательно =====

# Токен бота: напиши @BotFather → /newbot
BOT_TOKEN=

# Ключ Polza.ai: личный кабинет → API-ключи
POLZA_API_KEY=

# ===== Чтение Telegram-каналов =====
# my.telegram.org → API development tools (войди тем аккаунтом, который будет читать каналы).
# Если оставить пустым — бот будет читать только сайты.
TG_API_ID=
TG_API_HASH=

# ===== Необязательно =====

# Твой Telegram ID, можно несколько через запятую (например, второй свой аккаунт).
# Если пусто — владельцем станет первый, кто напишет боту /start.
# Второй аккаунт можно добавить и из бота: нажми с него /start — на основной придёт кнопка «Пустить»
OWNER_ID=

# Модели. Каталог и цены: https://polza.ai/models
LLM_MODEL_FAST=openai/gpt-4.1-mini
LLM_MODEL_SMART=openai/gpt-5.4

# Подборки (время и количество можно менять прямо в боте: /time, /size, /threshold)
DIGEST_TIMES=10:00,19:00
TIMEZONE=Europe/Moscow
# сколько тем в подборке: 0 — все новые по тематике
DIGEST_SIZE=0
MIN_SCORE=6
# посты старше стольких дней не берём
MAX_AGE_DAYS=3
COLLECT_INTERVAL_MIN=30

# Прокси для Telegram (нужен, если провайдер блокирует Telegram):
#   auto — взять системный прокси (так работают VPN-клиенты в режиме «системный прокси»)
#   off  — подключаться напрямую
#   или адрес локального порта VPN-клиента: socks5://127.0.0.1:10808 или http://127.0.0.1:10809
TG_PROXY=auto
